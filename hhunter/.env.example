# RapidAPI key for Zillow and Realtor.com access
# Sign up free at https://rapidapi.com — subscribe to "zillow56" and "realty-in-us"
RAPIDAPI_KEY=your_rapidapi_key_here

# Google Maps API key for commute time calculation (rush hour traffic)
# Enable "Distance Matrix API" at https://console.cloud.google.com
# Free tier includes $200/month credit
GOOGLE_MAPS_API_KEY=your_google_maps_key_here

# Anthropic API key for AI-powered listing analysis (optional)
# Sign up at https://console.anthropic.com
ANTHROPIC_API_KEY=your_anthropic_key_here
